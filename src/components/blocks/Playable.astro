---
// A game playable in the page. It only loads once the visitor presses play. Usage in .mdx:
//   <Playable src="https://itch.io/embed-upload/1234567" aspect="16 / 9" />
//   <Playable src="/builds/my-prototype/index.html" />
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { publicUrl } from '../../lib/format';

interface Props {
  /**
   * The itch.io embed URL (on itch.io: Edit game → Distribute → Embed game → copy the iframe's src),
   * or a web build in `public/`, written from the site root, e.g. `/builds/my-game/index.html`.
   */
  src: string;
  /** Shape of the game view as width / height, e.g. "16 / 9" or "960 / 600". */
  aspect?: string;
  title?: string;
  /** Image shown behind the play button. */
  cover?: ImageMetadata;
}

const { src, aspect = '16 / 9', title = 'Game', cover } = Astro.props;
---

<figure class="playable wide" data-playable data-src={publicUrl(src)} data-title={title}>
  <div class="stage" style={`aspect-ratio: ${aspect}`}>
    {cover && <Image src={cover} alt="" widths={[800, 1600]} sizes="(max-width: 1200px) 100vw, 1160px" />}
    <button class="start" type="button">▶ Play in browser</button>
  </div>
  <figcaption>
    <span>The game loads when you press play.</span>
    <button class="fullscreen" type="button">Fullscreen</button>
  </figcaption>
</figure>

<style>
  .playable {
    margin-block: 0 clamp(2rem, 5vw, 3.5rem);
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius);
    background: #000;
  }

  .stage:fullscreen {
    border-radius: 0;
  }

  .stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  .stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .start {
    position: relative;
    padding: 0.8rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font: inherit;
    font-weight: 600;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    cursor: pointer;
    transition: transform 0.15s;
  }

  .start:hover {
    transform: scale(1.05);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    text-align: left;
  }

  .fullscreen {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>

<script>
  for (const playable of document.querySelectorAll<HTMLElement>('[data-playable]')) {
    const stage = playable.querySelector<HTMLElement>('.stage')!;

    const start = () => {
      if (stage.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src = playable.dataset.src!;
      frame.title = playable.dataset.title!;
      frame.allow = 'autoplay; fullscreen; gamepad';
      frame.allowFullscreen = true;
      stage.replaceChildren(frame);
      frame.focus();
    };

    playable.querySelector('.start')!.addEventListener('click', start);
    playable.querySelector('.fullscreen')!.addEventListener('click', () => {
      start();
      stage.requestFullscreen?.();
    });
  }
</script>
