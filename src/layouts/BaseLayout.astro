---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { url } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific CSS (theme overrides, then `customCss`), applied after the site's own styles. */
  css?: string[];
}

const { title, description = site.description, css = [] } = Astro.props;

const nav = [
  { href: url('/work/'), label: 'Work' },
  { href: url('/productions/'), label: 'Productions' },
  { href: url('/about/'), label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Light/dark theme. Follows the system setting until the visitor uses the toggle, then remembers
      // the choice in localStorage (no cookies). Runs in <head> so pages never flash the wrong theme.
      (() => {
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        if (saved !== 'light' && saved !== 'dark') saved = null;

        const apply = () => {
          root.dataset.theme = saved ?? (system.matches ? 'dark' : 'light');
          for (const button of document.querySelectorAll('[data-theme-toggle]')) {
            button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
          }
        };

        // Switch every color at once, instead of links fading while everything else snaps.
        const switchTheme = () => {
          root.classList.add('theme-switching');
          apply();
          void document.body.offsetHeight;
          root.classList.remove('theme-switching');
        };

        apply();
        document.addEventListener('DOMContentLoaded', apply);
        system.addEventListener('change', () => {
          if (!saved) switchTheme();
        });
        document.addEventListener('click', (event) => {
          if (!event.target.closest?.('[data-theme-toggle]')) return;
          saved = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', saved);
          } catch {}
          switchTheme();
        });
      })();
    </script>
    {css.filter(Boolean).map((styles) => <style is:inline set:html={styles} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="site-name" href={url('/')}>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
          <span class="theme-icon-moon"><Icon name="moon" size={18} /></span>
          <span class="theme-icon-sun"><Icon name="sun" size={18} /></span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {site.name}</span>
        {
          site.links.length > 0 && (
            <ul class="inline-list footer-links">
              {site.links.map((link) => (
                <li>
                  <a href={link.url}>
                    <Icon name={link.icon} size={16} />
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </footer>
  </body>
</html>
